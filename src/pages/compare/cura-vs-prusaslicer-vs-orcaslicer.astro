---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import SeoJsonLd from '../../components/SeoJsonLd.astro';
import { getResourceBySlug } from '../../data/resources.js';
import { breadcrumbSchema, faqSchema, itemListSchema } from '../../utils/structured-data';

const slicers = ['cura', 'prusa-slicer', 'orcaslicer'].map(slug => getResourceBySlug(slug)).filter(Boolean);
const title = 'Cura vs PrusaSlicer vs OrcaSlicer';
const description = 'A practical comparison of Cura, PrusaSlicer, and OrcaSlicer for FDM 3D printing: beginner fit, platform support, workflow style, and who should try each slicer first.';
const verdicts = {
  cura: 'Start here if you want the familiar default choice, huge community answers, and broad printer support.',
  'prusa-slicer': 'Pick this if you like a tidy, engineering-minded workflow and want strong profiles without too much hand-holding.',
  orcaslicer: 'Try this if you enjoy tuning, calibration helpers, and a faster-moving power-user slicer.'
};
const faqs = [
  {
    question: 'Which slicer is best for beginners?',
    answer: 'Cura is often the easiest first stop because it is widely used and there are many tutorials. PrusaSlicer is also friendly if your printer has a good profile. OrcaSlicer is powerful, but it makes more sense once you are comfortable changing settings.'
  },
  {
    question: 'Can I keep more than one slicer installed?',
    answer: 'Yes. Many makers keep two slicers around, but it is better to learn one well before comparing every setting across three apps.'
  },
  {
    question: 'Do these slicers cost money?',
    answer: 'The three slicers compared here are listed as free in the printer.tools directory.'
  }
];
---

<Layout title={title} description={description} keywords={['Cura vs PrusaSlicer', 'OrcaSlicer vs Cura', 'best 3D printing slicer', 'FDM slicer comparison']}>
  <SeoJsonLd data={breadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'Compare', url: '/compare/cura-vs-prusaslicer-vs-orcaslicer' }, { name: title, url: '/compare/cura-vs-prusaslicer-vs-orcaslicer' }])} />
  <SeoJsonLd data={itemListSchema(title, description, '/compare/cura-vs-prusaslicer-vs-orcaslicer', slicers)} />
  <SeoJsonLd data={faqSchema(faqs)} />

  <div class="container mx-auto px-6 py-8">
    <Breadcrumbs items={[{ label: 'Compare' }, { label: title }]} />

    <section class="mb-8 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm md:p-8">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-blue-700">Slicer bench notes</p>
      <h1 class="text-3xl font-bold tracking-tight text-gray-950 md:text-5xl">Cura vs PrusaSlicer vs OrcaSlicer</h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-gray-600">
        There is no universal “best slicer.” The better question is which one matches your patience, printer profile, and appetite for tuning. Here is the short version before you spend an evening moving the same Benchy through three apps.
      </p>
    </section>

    <div class="mb-8 grid gap-4 lg:grid-cols-3">
      {slicers.map((slicer) => (
        <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
          <ResourceCard resource={slicer} compact />
          <p class="mt-4 border-t border-gray-100 pt-4 text-sm leading-relaxed text-gray-700">{verdicts[slicer.slug]}</p>
        </div>
      ))}
    </div>

    <section class="mb-8 overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
      <div class="grid grid-cols-4 bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-500">
        <div class="p-3">Question</div>
        {slicers.map((slicer) => <div class="p-3">{slicer.name}</div>)}
      </div>
      <div class="divide-y divide-gray-100 text-sm">
        <div class="grid grid-cols-4">
          <div class="p-3 font-medium text-gray-950">Best fit</div>
          <div class="p-3 text-gray-700">First slicer, broad help, many printer profiles</div>
          <div class="p-3 text-gray-700">Balanced control and clean defaults</div>
          <div class="p-3 text-gray-700">Calibration-heavy tuning and newer workflows</div>
        </div>
        <div class="grid grid-cols-4">
          <div class="p-3 font-medium text-gray-950">Learning curve</div>
          <div class="p-3 text-gray-700">Gentle</div>
          <div class="p-3 text-gray-700">Moderate</div>
          <div class="p-3 text-gray-700">Moderate to advanced</div>
        </div>
        <div class="grid grid-cols-4">
          <div class="p-3 font-medium text-gray-950">Platforms</div>
          {slicers.map((slicer) => <div class="p-3 text-gray-700">{slicer.platforms.join(', ')}</div>)}
        </div>
        <div class="grid grid-cols-4">
          <div class="p-3 font-medium text-gray-950">Price</div>
          {slicers.map((slicer) => <div class="p-3 text-gray-700">{slicer.price}</div>)}
        </div>
      </div>
    </section>

    <section class="grid gap-4 md:grid-cols-3">
      {faqs.map((item) => (
        <article class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
          <h2 class="font-semibold text-gray-950">{item.question}</h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">{item.answer}</p>
        </article>
      ))}
    </section>
  </div>
</Layout>
