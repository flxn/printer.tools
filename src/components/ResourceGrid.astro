---
import ResourceCard from './ResourceCard.astro';

const { resources = [], emptyMessage = 'No resources found.' } = Astro.props;
---

{resources.length > 0 ? (
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {resources.map((resource) => <ResourceCard resource={resource} />)}
  </div>
) : (
  <div class="rounded-xl border border-gray-200 bg-white p-8 text-center text-gray-600">
    {emptyMessage}
  </div>
)}
